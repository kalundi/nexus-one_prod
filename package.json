{
  "name": "nexus-one-build-042",
  "version": "0.42.0",
  "private": true,
  "description": "Nexus ONE unified booking and real-time integrations",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "build:prod": "node scripts/build-static.mjs && node scripts/obfuscate-code.mjs",
    "obfuscate": "node scripts/obfuscate-code.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "verify": "node scripts/verify-build042.mjs",
    "start": "netlify dev --dir dist",
    "admin:create-test": "node scripts/create-test-admin.mjs",
    "test:create-users": "node scripts/create-test-users.mjs",
    "driver:add-fletcher": "node scripts/add-fletcher-driver.mjs",
    "fleet:seed": "node scripts/seed-fleet.mjs",
    "seed:demo": "node scripts/seed-demo-bookings.mjs",
    "debug:admin": "node scripts/debug-admin.mjs",
    "test:broker": "node scripts/local-test-server.cjs",
    "mobile:driver:install": "npm --prefix mobile/driver-ios install",
    "mobile:driver:ios:add": "npm --prefix mobile/driver-ios run ios:add",
    "mobile:driver:ios:sync": "npm --prefix mobile/driver-ios run ios:sync",
    "mobile:driver:ios:open": "npm --prefix mobile/driver-ios run ios:open",
    "mobile:booking:install": "npm --prefix mobile/booking-ios install",
    "mobile:booking:ios:add": "npm --prefix mobile/booking-ios run ios:add",
    "mobile:booking:ios:sync": "npm --prefix mobile/booking-ios run ios:sync",
    "mobile:booking:ios:open": "npm --prefix mobile/booking-ios run ios:open",
    "mobile:patient:install": "npm --prefix mobile/patient-ios install",
    "mobile:patient:ios:add": "npm --prefix mobile/patient-ios run ios:add",
    "mobile:patient:ios:sync": "npm --prefix mobile/patient-ios run ios:sync",
    "mobile:patient:ios:open": "npm --prefix mobile/patient-ios run ios:open"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "http-server": "^14.1.1",
    "javascript-obfuscator": "^4.2.0"
  }
}
