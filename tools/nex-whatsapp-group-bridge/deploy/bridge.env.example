# Template ONLY. Never commit bridge.env with real values.
# Copy to /etc/nex-wa/bridge.env, chmod 0600, root-owned.
NEX_GROUP_ACCOUNT_MODE=existing_business
NEX_GROUP_EXISTING_BUSINESS_OWNER_AUTHORIZED=false
NEX_GROUP_EXISTING_BUSINESS_RISK_ACKNOWLEDGED=false
NEX_GROUP_OTHER_CHAT_SYNC_RISK_ACKNOWLEDGED=false
# The expected E.164 number and shared signing key belong in protected
# systemd credential files /etc/nex-wa/expected-number and
# /etc/nex-wa/shared-secret, not in this environment file.
NEX_GROUP_AUTH_DIR=/var/lib/nex-wa/session
NEX_GROUP_DISCOVERY_MODE=false
NEX_GROUP_BRIDGE_ENABLED=false
NEX_GROUP_NOTICE_CONFIRMED=false
NEX_GROUP_ALLOWLIST=
NEX_GROUP_INGEST_URL=https://nexusmt.com/.netlify/functions/nex-group-ingest
